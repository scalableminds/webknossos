{
 "version": 1,
 "description": "Dataset uploads through the datastores (Play's embedded one vs the standalone one calling back Rust): reserve, chunk upload, finish, cancel, and the main-application side effects.",
 "header_divergences": {
  "cache-control": "Rust sends `Cache-Control: no-store` on every API response (README: cache prevention); Play sends `no-cache` on most and nothing on auth errors. Play sends no validators (ETag/Last-Modified), so both force a refetch; no-store additionally forbids storage. Deliberate."
 },
 "drop_play_chain_messages": "Play appends {\"chain\": \"[Server Time \u2026] \u2026\"} to messages of failed Fox chains (debug context with the server time). Rust returns only the error entry; the frontend shows `error` entries.",
 "unordered_keys": {
  "annotationLayers": "Play's AnnotationLayerDAO orders layers by tracingId, a random UUID per side.",
  "tags": "Scala Set semantics (annotation.tags ++ Set(dataset.name)); hash order for more than four tags.",
  "jobsSupportedByAvailableWorkers": "DataStoreService.publicWrites serializes JobService.jobsSupportedByAvailableWorkers, a Scala Set (hash order); Rust sorts.",
  "supportedJobCommands": "Worker.supportedJobCommands is a Scala Set (hash order); Rust keeps the stored order."
 },
 "side_rewrites": {
  "rust": {
   "http://127.0.0.1:19595": "http://127.0.0.1:19590",
   "http://127.0.0.1:19596": "http://127.0.0.1:19590",
   "/tmp/wk-diff/rust-data/": "/tmp/wk-diff/play-data/"
  }
 },
 "identities": {
  "admin": {
   "token": "secretSampleUserToken"
  },
  "user2": {
   "cookie": "{user2Cookie}"
  }
 },
 "db_divergences": {
  "datasets": {
   "reason": "Play bug: WKRemoteDataStoreController.reserveDatasetUpload creates the pending dataset before validating initialTeamIds, so a reservation with an unknown team fails (400) but leaves the dataset row behind. Rust validates first and creates nothing; both answer 400.",
   "rows": [
    {
     "name": "diff-t"
    }
   ]
  }
 },
