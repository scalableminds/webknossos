package build

import java.lang.reflect.Modifier
import java.net.URLClassLoader

/** Generates JNI header files for the native methods of compiled classes, like the javah tool did. */
object JniHeaders {

  def generate(classesDir: os.Path, classpath: Seq[os.Path], outDir: os.Path): Unit = {
    val classNames = os
      .walk(classesDir)
      .filter(_.ext == "class")
      .map(_.relativeTo(classesDir).segments.mkString(".").stripSuffix(".class"))
    val classLoader = new URLClassLoader(
      classpath.map(_.toNIO.toUri.toURL).toArray,
      ClassLoader.getPlatformClassLoader
    )
    val nativeClasses = classNames.filter { name =>
      try Class.forName(name, false, classLoader).getDeclaredMethods.exists(m => Modifier.isNative(m.getModifiers))
      catch { case _: Throwable => false }
    }
    for (className <- nativeClasses.sorted) {
      val headerFile = outDir / s"${mangle(className)}.h"
      os.write.over(headerFile, header(className, nativeMethods(className, classesDir)))
      println(s"Wrote $headerFile")
    }
  }

  private case class NativeMethod(name: String, descriptor: String, isStatic: Boolean)

  // javap lists the methods in declaration order, reflection does not.
  private def nativeMethods(className: String, classesDir: os.Path): Seq[NativeMethod] = {
    val javap = os.Path(sys.props("java.home")) / "bin" / "javap"
    val lines = os.call((javap, "-s", "-p", "-cp", classesDir, className)).out.lines()
    lines.zip(lines.drop(1)).collect {
      case (declaration, descriptorLine) if declaration.contains(" native ") =>
        NativeMethod(
          name = declaration.substring(0, declaration.indexOf('(')).split(' ').last,
          descriptor = descriptorLine.trim.stripPrefix("descriptor:").trim,
          isStatic = declaration.contains(" static ")
        )
    }
  }

  private def header(className: String, methods: Seq[NativeMethod]): String = {
    val mangledClass = mangle(className)
    val overloaded = methods.groupBy(_.name).collect { case (name, ms) if ms.size > 1 => name }.toSet
    val methodDeclarations = methods.map { method =>
      val (params, returnType) = parseDescriptor(method.descriptor)
      val overloadSuffix =
        if (overloaded.contains(method.name)) "__" + mangle(method.descriptor.drop(1).takeWhile(_ != ')')) else ""
      val args = Seq("JNIEnv *", if (method.isStatic) "jclass" else "jobject") ++ params
      s"""/*
         | * Class:      $mangledClass
         | * Method:     ${method.name}
         | * Signature:  ${method.descriptor}
         | */
         |JNIEXPORT $returnType JNICALL Java_${mangledClass}_${mangle(method.name)}$overloadSuffix
         |  (${args.mkString(", ")});
         |
         |""".stripMargin
    }
    s"""/* DO NOT EDIT THIS FILE - it is machine generated */
       |#include <jni.h>
       |/* Header for class $mangledClass */
       |
       |#ifndef _Included_$mangledClass
       |#define _Included_$mangledClass
       |#ifdef __cplusplus
       |extern "C" {
       |#endif
       |${methodDeclarations.mkString}#ifdef __cplusplus
       |}
       |#endif
       |#endif
       |""".stripMargin
  }

  /** Splits a method descriptor like ([BIZ)[J into the JNI types of its parameters and of its return value. */
  private def parseDescriptor(descriptor: String): (Seq[String], String) = {
    def parseType(s: String): (String, String) = s.head match {
      case '[' =>
        val (elementType, rest) = parseType(s.tail)
        val arrayType = if (s(1) == '[' || s(1) == 'L') "jobjectArray" else elementType + "Array"
        (arrayType, rest)
      case 'L' =>
        val (name, rest) = s.tail.span(_ != ';')
        val jniType = name match {
          case "java/lang/String"    => "jstring"
          case "java/lang/Class"     => "jclass"
          case "java/lang/Throwable" => "jthrowable"
          case _                     => "jobject"
        }
        (jniType, rest.tail)
      case c =>
        val primitive = Map(
          'Z' -> "jboolean",
          'B' -> "jbyte",
          'C' -> "jchar",
          'S' -> "jshort",
          'I' -> "jint",
          'J' -> "jlong",
          'F' -> "jfloat",
          'D' -> "jdouble",
          'V' -> "void"
        )
        (primitive(c), s.tail)
    }
    def parseAll(s: String): List[String] =
      if (s.isEmpty) Nil
      else {
        val (t, rest) = parseType(s)
        t :: parseAll(rest)
      }
    val (params, returnType) = descriptor.drop(1).span(_ != ')')
    (parseAll(params), parseType(returnType.drop(1))._1)
  }

  // Name mangling as specified by JNI
  private def mangle(name: String): String = name.flatMap {
    case '.' | '/'                     => "_"
    case '_'                           => "_1"
    case ';'                           => "_2"
    case '['                           => "_3"
    case c if c.isLetterOrDigit && c < 128 => c.toString
    case c                             => f"_0${c.toInt}%04x"
  }
}
