    "nome": "x"
   },
   "expected_divergence": {
    "reason": "JSON body validation failures: Play returns its JsError structure ({\"obj.name\":[{\"msg\":[\"error.path.missing\"],\"args\":[]}]}), Rust returns {\"messages\":[{\"error\":\"Invalid JSON request body.\"}]}; both 400. Only reachable by malformed clients.",
    "paths": [
