{
 "version": 1,
 "description": "Authentication and session lifecycle: password login, cookies vs tokens, registration, invites, password change/reset, logout variants.",
 "header_divergences": {
  "cache-control": "Rust sends `Cache-Control: no-store` on every API response (README: cache prevention); Play sends `no-cache` on most and nothing on auth errors. Play sends no validators (ETag/Last-Modified), so both force a refetch; no-store additionally forbids storage. Deliberate."
 },
 "drop_play_chain_messages": "Play appends {\"chain\": \"[Server Time \u2026] \u2026\"} to messages of failed Fox chains (debug context with the server time). Rust returns only the error entry; the frontend shows `error` entries.",
 "unordered_keys": {
  "annotationLayers": "Play's AnnotationLayerDAO orders layers by tracingId, a random UUID per side.",
  "tags": "Scala Set semantics (annotation.tags ++ Set(dataset.name)); hash order for more than four tags.",
  "jobsSupportedByAvailableWorkers": "DataStoreService.publicWrites serializes JobService.jobsSupportedByAvailableWorkers, a Scala Set (hash order); Rust sorts.",
  "supportedJobCommands": "Worker.supportedJobCommands is a Scala Set (hash order); Rust keeps the stored order."
 },
 "side_rewrites": {
  "rust": {
   "http://127.0.0.1:19595": "http://127.0.0.1:19590",
   "http://127.0.0.1:19596": "http://127.0.0.1:19590",
   "/tmp/wk-diff/rust-data/": "/tmp/wk-diff/play-data/"
  }
 },
 "db_random_columns": {
  "tokens.value": "random authenticator/token values (Play RandomIDGenerator format on both sides)",
  "multiusers.passwordinfo_password": "bcrypt hashes with random salt",
  "emailverificationkeys.key": "random verification key",
  "invites.tokenvalue": "random invite token"
 },
 "identities": {
  "admin": {
   "token": "secretSampleUserToken"
  },
  "user2": {
   "cookie": "{user2Cookie}"
  },
  "user2token": {
   "token": "{user2Token}"
  },
  "user2b": {
   "cookie": "{user2Cookie2}"
  },
  "user2c": {
   "cookie": "{user2Cookie3}"
  },
  "formsession": {
   "cookie": "{formCookie}"
  }
 },
 "steps": [
  {
   "name": "login-wrong-password",
   "method": "POST",
   "path": "/api/auth/login",
   "json": {
    "email": "sample2@scm.io",
    "password": "wrong"
   }
  },
  {
   "name": "login-unknown-user",
   "method": "POST",
   "path": "/api/auth/login",
   "json": {
    "email": "nobody@diff.test",
    "password": "secret"
   }
  },
  {
   "name": "login-missing-field",
   "method": "POST",
   "path": "/api/auth/login",
   "json": {
    "email": "sample2@scm.io"
   },
   "expected_divergence": {
    "reason": "Invalid form submissions: Play renders the Form object's toString as the error text (text/plain, includes the submitted values incl. the password in clear text); Rust returns a JSON message naming the failing fields. Both 400.",
    "paths": [
     "$",
     "<header:content-type>"
    ]
   }
  },
  {
   "name": "login-form",
   "method": "POST",
   "path": "/api/auth/login",
   "form": {
    "email": "sample2@scm.io",
    "password": "secret"
   },
   "capture_cookie": {
    "formCookie": "id"
   }
  },
  {
   "name": "login-json",
   "method": "POST",
   "path": "/api/auth/login",
   "json": {
    "email": "sample2@scm.io",
    "password": "secret"
   },
   "capture_cookie": {
    "user2Cookie": "id"
   }
  },
  {
   "name": "user-via-cookie",
   "method": "GET",
   "path": "/api/user",
   "as": "user2",
   "ignore": [
    {
     "path": "$.lastActivity",
     "reason": "Play renders request.identity from its 3-minute user cache; Rust reads the row."
    }
   ]
  },
  {
   "name": "token-get",
   "method": "GET",
   "path": "/api/auth/token",
   "as": "user2",
   "capture": {
    "user2Token": "$.token"
   },
   "ignore": [
    {
     "path": "$.token",
     "reason": "random per side, paired via capture"
    }
   ]
  },
  {
   "name": "token-get-again",
   "method": "GET",
   "path": "/api/auth/token",
   "as": "user2",
   "ignore": [
    {
     "path": "$.token",
     "reason": "random per side, paired via capture"
    }
   ]
  },
  {
   "name": "user-via-token",
   "method": "GET",
   "path": "/api/user",
   "as": "user2token",
   "ignore": [
    {
     "path": "$.lastActivity",
