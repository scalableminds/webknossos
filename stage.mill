package build

import java.util.zip.{ZipEntry, ZipOutputStream}

/** Helpers for WkPlayModule.stage, which lays out a deployable app like sbt-native-packager did. */
object Stage {

  /** Copies the dependency jars to libDir. Jars with the same file name get the name of their parent dirs prefixed. */
  def copyDependencyJars(jars: Seq[os.Path], libDir: os.Path): Seq[os.Path] = {
    val ambiguousNames = jars.groupBy(_.last).collect { case (name, paths) if paths.size > 1 => name }.toSet
    jars.map { jar =>
      val name =
        if (ambiguousNames.contains(jar.last)) (jar / os.up / os.up / os.up).last + "." + jar.last
        else jar.last
      val target = libDir / name
      os.copy(jar, target, createFolders = true, replaceExisting = true)
      target
    }
  }

  /** Packages the files of dir into a jar under public/, keeping their timestamps. */
  def createAssetsJar(dir: os.Path, jar: os.Path): Unit = {
    val zip = new ZipOutputStream(os.write.outputStream(jar, createFolders = true))
    try {
      if (os.isDir(dir)) {
        for (file <- os.walk(dir).filter(os.isFile).sorted) {
          val entry = new ZipEntry("public/" + file.relativeTo(dir).toString)
          entry.setTime(os.mtime(file))
          zip.putNextEntry(entry)
          os.read.stream(file).writeBytesTo(zip)
          zip.closeEntry()
        }
      }
    } finally zip.close()
  }

  /** A launcher for a Play app. Its classpath entries are relative to the app directory. */
  def launcherScript(classpath: Seq[String]): String = {
    val classpathString = classpath.map(entry => "$app_home/" + entry).mkString(":")
    s"""#!/usr/bin/env bash
       |# Starts the app. Generated by the Mill build (see build.mill, stage).
       |# Arguments:
       |#   -J<option>         passed to the JVM, e.g. -J-Xmx20G
       |#   -D<key>=<value>    system property, e.g. -Dconfig.file=conf/application.conf
       |#   -jvm-debug <port>  enables remote debugging
       |# All other arguments are passed to the app. The JAVA_OPTS env var holds further JVM options.
       |
       |app_home="$$(cd "$$(dirname "$$(realpath "$$0")")/.." && pwd -P)"
       |
       |java_opts=()
       |app_args=()
       |while [ $$# -gt 0 ]; do
       |  case "$$1" in
       |    -J*) java_opts+=("$${1:2}"); shift ;;
       |    -D*|-XX*|-agentlib*|-agentpath*|-javaagent*) java_opts+=("$$1"); shift ;;
       |    -jvm-debug) java_opts+=("-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=$$2"); shift 2 ;;
       |    *) app_args+=("$$1"); shift ;;
       |  esac
       |done
       |
       |if [ -n "$$JAVA_HOME" ]; then java_cmd="$$JAVA_HOME/bin/java"; else java_cmd="java"; fi
       |
       |# shellcheck disable=SC2086 # JAVA_OPTS may hold several options
       |exec "$$java_cmd" $$JAVA_OPTS "$${java_opts[@]}" -Duser.dir="$$app_home" \\
       |  -cp "$classpathString" \\
       |  play.core.server.ProdServerStart "$${app_args[@]}"
       |""".stripMargin
  }
}
