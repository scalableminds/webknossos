# Shell-compatible configuration example. The binary does NOT read .env files.
# Source explicitly: set -a; . ./datastore/.env; set +a
# Defaults below target standalone-datastore.conf, not integrated application.conf.
# Replace WK_DS_KEY with the datastore key registered in WEBKNOSSOS before deployment.
# Use absolute base paths in deployments; relative paths resolve against process cwd.
# Watcher off does NOT disable status reporting or orphan-upload cleanup.
# Unknown WK_DS_* variables are ignored. Check DEPLOYMENT.md for unsupported settings.
RUST_LOG=info
WK_DS_AD_HOC_MESH_ACTOR_POOL_SIZE='8'
WK_DS_AD_HOC_MESH_TIMEOUT='30 seconds'
WK_DS_AGGLOMERATE_TREE_MAX_EDGES='1000000'
WK_DS_BASE_DIRECTORIES='[{"path":"binaryData","organizationId":null,"allowsUpload":true,"doScan":true}]'
WK_DS_CACHE_AGGLOMERATE_FILE_BLOCK_SIZE='512'
WK_DS_CACHE_AGGLOMERATE_FILE_CUMSUM_MAX_READER_RANGE='1310720'
WK_DS_CACHE_AGGLOMERATE_FILE_MAX_SEGMENT_ID_ENTRIES='625000'
WK_DS_CACHE_IMAGE_ARRAY_CHUNKS_MAX_SIZE_BYTES='2000000000'
WK_DS_CACHE_MAPPING_MAX_ENTRIES='5'
WK_DS_DATA_VAULTS_CREDENTIALS='[]'
WK_DS_HTTP_ADDRESS='0.0.0.0'
WK_DS_HTTP_PORT='9090'
WK_DS_HTTP_URI='http://localhost:9090'
WK_DS_KEY='REPLACE_WITH_REGISTERED_DATASTORE_KEY'
WK_DS_LOCAL_DIRECTORY_WHITELIST='[]'
WK_DS_NAME='standalone-9090'
WK_DS_PARSER_MAX_DISK_BUFFER='1G'
WK_DS_PARSER_MAX_MEMORY_BUFFER='250M'
WK_DS_REDIS_ADDRESS='localhost'
WK_DS_REDIS_PORT='6379'
WK_DS_REQUEST_TIMEOUT='10000s'
WK_DS_SHUTDOWN_TIMEOUT='30 seconds'
WK_DS_SLACK_NOTIFICATIONS_URI=''
WK_DS_WATCH_FILE_SYSTEM_ENABLED='true'
WK_DS_WATCH_FILE_SYSTEM_INTERVAL='1 minute'
WK_DS_WEBKNOSSOS_URI='http://localhost:9000'
WK_DS_AGGLOMERATE_GRAPH_MAX_EDGES='10000000'
WK_DS_CACHE_AGGLOMERATE_FILE_MAX_FILE_HANDLE_ENTRIES='15'
WK_DS_WEBKNOSSOS_PING_INTERVAL='10 minutes'
WK_DS_WATCH_FILE_SYSTEM_INITIAL_DELAY='5 seconds'
WK_DS_WRITE_VIRTUAL_DATASETS_MIRROR='false'
WK_DS_UPLOAD_DELETE_TEMPORARY_FILES_AFTER_UPLOAD='false'
WK_DS_SLACK_NOTIFICATIONS_VERBOSE_LOGGING_ENABLED='false'
