    ],
    "autoActivate": false,
    "isAdmin": false,
    "isDatasetManager": false,
    "teamMemberships": []
   },
   "expect_status": 200,
   "expected_divergence": {
    "reason": "Plain member inviting without team roles: Play sends the invite (200, invite row and email); Rust lets only admins and team managers send invites (hardening 46552fe734, \"plain members may not invite at all\") and answers 403.",
    "paths": [
     "$"
    ]
   }
  },
