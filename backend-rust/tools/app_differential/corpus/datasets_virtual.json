   "method": "POST",
   "path": "/api/datasets/addVirtualDataset/diff-virtual",
   "as": "admin",
   "json": {
    "dataSource": {
     "id": {
      "name": "diff-virtual",
      "team": "sample_organization"
     },
     "dataLayers": [
      {
       "name": "color",
       "category": "color",
       "dataFormat": "zarr3",
       "boundingBox": {
        "topLeft": [
         3072,
         3072,
         512
        ],
        "width": 1024,
        "height": 1024,
        "depth": 1024
       },
       "elementClass": "uint8",
       "mags": [
        {
         "mag": [
          1,
          1,
          1
         ],
         "path": "https://static.webknossos.org/data/zarr_v3/l4_sample/color/1"
        },
        {
         "mag": [
          2,
          2,
          1
         ],
         "path": "https://static.webknossos.org/data/zarr_v3/l4_sample/color/2-2-1"
        }
       ]
      }
     ],
     "scale": {
      "factor": [
       11.24,
       11.24,
       28
      ],
      "unit": "nanometer"
     }
    },
    "folderId": "{seedRootFolderId}",
    "dataStoreName": "localhost",
    "importUrl": "https://static.webknossos.org/data/zarr_v3/l4_sample"
   },
   "capture": {
    "virtualId": "$.newDatasetId"
