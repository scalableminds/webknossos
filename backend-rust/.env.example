# Set explicitly in the process environment; .env files are not auto-loaded.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/webknossos
WK_BIND=127.0.0.1:9001
WK_PUBLIC_URL=http://localhost:9000
WK_DB_MIN_CONNECTIONS=1
WK_DB_MAX_CONNECTIONS=10
WK_DB_ACQUIRE_TIMEOUT_SECONDS=5
# Database session TimeZone. Default: like the JVM (TZ, then /etc/localtime, then UTC). Must equal the zone
# Play's JDBC sessions use while both share the database (month boundaries of free credits, mutex expiry).
# WK_DB_TIME_ZONE=UTC
# Separate listener for Prometheus metrics at GET /metrics (private network only). Unset: disabled.
# WK_METRICS_BIND=127.0.0.1:9101
WK_REQUEST_TIMEOUT_SECONDS=30
WK_SHUTDOWN_TIMEOUT_SECONDS=30
WK_BODY_LIMIT_BYTES=2097152
WK_EMAIL_VERIFICATION_ENABLED=true
WK_JOBS_ENABLED=true
WK_AUTH_TOKEN_EXPIRY_SECONDS=1987200000
WK_AUTH_TOKEN_IDLE_TIMEOUT_SECONDS=1987200000
WK_DATASTORE_TOKEN_EXPIRY_SECONDS=86400
# Annotation editing leases (Scala webKnossos.annotation.mutex.expiryTime).
WK_ANNOTATION_MUTEX_EXPIRY_SECONDS=120
# Time tracking (webKnossos.user.timeTracking*)
WK_TIME_TRACKING_PAUSE_MILLIS=60000
WK_TIME_TRACKING_ONLY_WITH_SIGNIFICANT_CHANGES=false
WK_PASSKEYS_ENABLED=false
WK_LOGOUT_REDIRECT_URL=/
WK_ALLOW_DELETE_DATASETS=true
WK_RPC_TIMEOUT_SECONDS=30
WK_RPC_CONNECT_TIMEOUT_SECONDS=5
WK_RPC_MAX_RESPONSE_BYTES=67108864
# WK_RPC_TOKEN is optional; absent means generate a fresh secret at startup.
RUST_LOG=webknossos_backend=info,tower_http=info
# Browser sessions (Silhouette-compatible cookies). Login/cookie auth is DISABLED unless the
# signer secret is set (>=16 chars); use Play's silhouette.cookieAuthenticator.signerSecret to share sessions.
# WK_COOKIE_SIGNER_SECRET=
WK_COOKIE_NAME=id
WK_COOKIE_PATH=/
WK_COOKIE_SECURE=false
WK_COOKIE_HTTP_ONLY=true
WK_COOKIE_SAME_SITE=Lax
WK_COOKIE_USE_FINGERPRINTING=true
WK_COOKIE_AUTHENTICATOR_EXPIRY_SECONDS=2592000
WK_COOKIE_MAX_AGE_SECONDS=31536000
WK_EMAIL_VERIFICATION_REQUIRED=false
WK_EMAIL_VERIFICATION_GRACE_PERIOD_SECONDS=604800
WK_EMAIL_VERIFICATION_LINK_EXPIRY_SECONDS=2592000
WK_INVITE_EXPIRY_SECONDS=1209600
WK_RESET_PASSWORD_TOKEN_EXPIRY_SECONDS=86400
WK_REGISTER_TO_DEFAULT_ORGA_ENABLED=true
WK_IS_WKORG_INSTANCE=false
WK_TERMS_OF_SERVICE_ENABLED=false
WK_TERMS_OF_SERVICE_VERSION=1
WK_NEW_ORGANIZATION_MAILING_LIST=
# Datasets (all optional)
# WK_EXTERNAL_PATH_DELETION_KEY=        # unset: /datasets/pathsToDelete always denies
# WK_SEGMENT_ANYTHING_ENABLED=false
# WK_SEGMENT_ANYTHING_URI= WK_SEGMENT_ANYTHING_USER= WK_SEGMENT_ANYTHING_PASSWORD=
# WK_UPLOAD_TO_PATHS_PREFIXES=          # comma list; empty -> ./binaryData
# WK_UPLOAD_TO_PATHS_INSERT_ORGANIZATION_DIRECTORY= WK_UPLOAD_TO_PATHS_INFIX=
# Application info / analytics (all optional)
# WK_FEATURES_JSON={}                   # frontend feature flags served by /features
# WK_BUILD_COMMIT_HASH= WK_BUILD_COMMIT_DATE= CI_BUILD_NUM= CI_TAG=
# WK_CERTIFICATE_PUBLIC_KEY= (or CERTIFICATE_PUBLIC_KEY) CERTIFICATE=
# WK_SUPPORT_EMAIL=
# WK_ANALYTICS_URI= (empty disables forwarding) WK_ANALYTICS_KEY= WK_ANALYTICS_SESSION_PAUSE_SECONDS=
# WK_ANALYTICS_SAVE_TO_DATABASE_ENABLED= WK_ANALYTICS_VERBOSE_LOGGING_ENABLED= WK_ANALYTICS_WELL_KNOWN_URIS=
# Initial data (/triggers/initialData). Default OFF in Rust (Play dev config has them on): enabling the
# sample organization lets an unauthenticated trigger create a superuser with well-known credentials.
# WK_SAMPLE_ORGANIZATION_ENABLED=false
# WK_SAMPLE_USER_EMAIL= WK_SAMPLE_USER_PASSWORD= WK_SAMPLE_USER_TOKEN= WK_SAMPLE_USER_IS_SUPER_USER=
# WK_LOCAL_DATASTORE_ENABLED=false WK_DATASTORE_NAME=localhost WK_DATASTORE_KEY= WK_DATASTORE_PUBLIC_URI=
# WK_LOCAL_TRACINGSTORE_ENABLED=false WK_TRACINGSTORE_NAME=localhost WK_TRACINGSTORE_KEY= WK_TRACINGSTORE_PUBLIC_URI=
WK_WORKER_LIVENESS_TIMEOUT_SECONDS=60
WK_JOB_TOKEN_EXPIRY_SECONDS=604800
# Voxelytics (enable via WK_FEATURES_JSON='{"voxelyticsEnabled":true}')
WK_VOXELYTICS_STALE_TIMEOUT_SECONDS=1200
# WK_VOXELYTICS_LOKI_URI=               # empty disables Loki (logs routes return Play's "Loki is not enabled.")
# WK_VOXELYTICS_LOKI_TENANT= WK_VOXELYTICS_LOKI_USER= WK_VOXELYTICS_LOKI_PASSWORD=
# WK_VOXELYTICS_LOKI_STARTUP_TIMEOUT_SECONDS=60
# OpenID Connect single sign-on (singleSignOn.openIdConnect.*); also drives /features openIdConnectEnabled
# WK_OIDC_ENABLED=false
# WK_OIDC_PROVIDER_URL=http://localhost:8080/auth/realms/master/
# WK_OIDC_CLIENT_ID=myclient WK_OIDC_CLIENT_SECRET=myClientSecret   # empty secret: no HTTP basic auth at the token endpoint
# WK_OIDC_SCOPE="openid profile email" WK_OIDC_VERBOSE_LOGGING=false WK_OIDC_HTTP_TIMEOUT_SECONDS=30
# WK_SSO_KEY=                           # Discourse SSO HMAC key for /auth/sso; empty = unconfigured
# WK_TASKS_MAX_OPEN_PER_USER=5          # webKnossos.tasks.maxOpenPerUser
# Housekeeping jobs (Scala WkCleanUpService + AnnotationMutexService ticker); see checkpoints/housekeeping.md.
# Each run takes a per-job pg_try_advisory_xact_lock, so several instances never run one job concurrently.
# WK_HOUSEKEEPING_ENABLED=true          # master switch
# Per job <JOB> in EXPIRED_TOKENS, OLD_TOKENS, EXPIRED_INVITES, INITIALIZING_ANNOTATIONS, EXPIRED_THUMBNAILS,
# EXPIRED_ANNOTATION_MUTEXES:
# WK_HOUSEKEEPING_<JOB>_ENABLED=true
# WK_HOUSEKEEPING_<JOB>_INTERVAL_SECONDS=86400        # EXPIRED_TOKENS: WK_DATASTORE_TOKEN_EXPIRY_SECONDS; MUTEXES: 3600
# WK_HOUSEKEEPING_<JOB>_INITIAL_DELAY_SECONDS=        # default: the interval (Scala fixed delay); MUTEXES: 10
# Free credit ticker (Scala FreeCreditTransactionService): revoke expired credits, then hand out the monthly
# free credits (WK_JOBS_MONTHLY_FREE_MILLI_CREDITS); pg_try_advisory_xact_lock-serialized across instances.
# WK_CREDIT_TICKER_ENABLED=true
# WK_CREDIT_TICKER_INTERVAL_SECONDS=1200
# WK_CREDIT_TICKER_INITIAL_DELAY_SECONDS=10
# Outgoing mail (Play mail.*); see checkpoints/smtp-mail.md. Empty WK_MAIL_SMTP_HOST = no delivery (logged only).
# WK_MAIL_SMTP_HOST=
# WK_MAIL_SMTP_PORT=465                 # with TLS: 465 = implicit TLS, any other port = STARTTLS when offered
# WK_MAIL_SMTP_TLS=true WK_MAIL_SMTP_AUTH=true
# WK_MAIL_SMTP_USER= WK_MAIL_SMTP_PASS= # secret; never logged
# WK_MAIL_DEFAULT_SENDER="WEBKNOSSOS <no-reply@webknossos.org>"
# WK_MAIL_ADDITIONAL_FOOTER=            # raw HTML appended to every mail footer (not escaped)
# WK_MAIL_LOG_TO_STDOUT=false           # log sender/recipients/subject of each mail (bodies never logged)
# WK_MAIL_NOTIFICATION_EMAILS_ACCESS_CHANGES=true            # mail users when others share with their teams, transfer to them, or change their teams/roles
# WK_MAIL_NOTIFICATION_EMAILS_MANUAL_TASK_ASSIGNMENTS=true   # mail users when a task is manually assigned to them
# Slack incoming-webhook notifications (slackNotifications.*): failed/successful jobs, suspicious registration
# names, added datasets, base-annotation task creation, failed credit revocations, schema mismatch, startup.
# WK_SLACK_NOTIFICATIONS_URI=                          # secret webhook URL; empty disables sending; never logged
# WK_SLACK_NOTIFICATIONS_VERBOSE_LOGGING_ENABLED=false # log every (or every unsent) message
# Mailchimp audience integration (mail.mailchimp.*, webknossos.org only); see checkpoints/mailchimp.md.
# Empty host = disabled (no requests, no ticker). Registration tags need WK_IS_WKORG_INSTANCE=true.
# WK_MAILCHIMP_HOST=                     # e.g. https://us1.api.mailchimp.com/3.0
# WK_MAILCHIMP_LIST_ID=
# WK_MAILCHIMP_USER=
# WK_MAILCHIMP_PASSWORD=                 # API key (basic auth password); never logged
# Activity ticker (Scala MailchimpTicker): tags multiusers 21-22 days after registration;
# pg_try_advisory_xact_lock-serialized across instances. Only runs with a host.
# WK_MAILCHIMP_TICKER_ENABLED=true
# WK_MAILCHIMP_TICKER_INTERVAL_SECONDS=3600
# WK_MAILCHIMP_TICKER_INITIAL_DELAY_SECONDS=3600
# Organization used-storage scan (Scala UsedStorageService ticker, webKnossos.fetchUsedStorage.*); see
# checkpoints/used-storage-scan.md. Only datastores with reportUsedStorageEnabled=TRUE are measured.
# Each run holds a pg_try_advisory_xact_lock, so several instances never scan concurrently.
# WK_USED_STORAGE_ENABLED=true
# WK_USED_STORAGE_TICKER_INTERVAL_SECONDS=600       # tickerInterval
# WK_USED_STORAGE_INITIAL_DELAY_SECONDS=60
# WK_USED_STORAGE_RESCAN_INTERVAL_SECONDS=86400     # rescanInterval: skip organizations scanned more recently
# WK_USED_STORAGE_SCANS_PER_TICK=10                 # scansPerTick: oldest scans first
# WK_USED_STORAGE_PAUSE_AFTER_ORGANIZATION_SECONDS=5
# Worker liveness monitor (Scala WorkerLivenessService, jobs.workerLivenessReReportInterval); see
# checkpoints/worker-liveness.md. Slack warn "Worker missing" when a worker's heartbeat is older than
# WK_WORKER_LIVENESS_TIMEOUT_SECONDS, again after the re-report interval; Slack success "Worker return".
# WK_WORKER_LIVENESS_ENABLED=true
# WK_WORKER_LIVENESS_INTERVAL_SECONDS=60
# WK_WORKER_LIVENESS_INITIAL_DELAY_SECONDS=60
# WK_WORKER_LIVENESS_RE_REPORT_INTERVAL_SECONDS=3600
# Pricing plan expiry reminder (Scala webKnossos.pricingPlanExpiryReminder); see
# checkpoints/pricing-plan-expiry-reminder.md. Mails the owner and admins of organizations whose paidUntil is
# within a lead time (one mail per crossed lead time, recorded in organization_planExpiryReminders).
# Disabled by default; also off when both lead time lists are empty. Lists are comma-separated whole days.
# WK_PRICING_PLAN_EXPIRY_REMINDER_ENABLED=false
# WK_PRICING_PLAN_EXPIRY_REMINDER_INTERVAL_SECONDS=21600
# WK_PRICING_PLAN_EXPIRY_REMINDER_INITIAL_DELAY_SECONDS=300
# WK_PRICING_PLAN_EXPIRY_REMINDER_LEAD_TIMES_DAYS=30,14,7
# WK_PRICING_PLAN_EXPIRY_REMINDER_TRIAL_LEAD_TIMES_DAYS=7
# Main view (Play AboutPageRedirectController + OpenGraphService): every non-API, non-asset path answers the
# built frontend's index.html with the user's theme and link-preview (OpenGraph) tags. /assets, /images,
# /wasm and the wkorg sitemap are not served; keep them on Play or a static file server.
# WK_PUBLIC_DIR=public                  # directory of the built index.html (vite's outDir), relative to the working dir
# WK_ABOUT_PAGE_REDIRECT_PREFIX=        # aboutPageRedirect.* (wkorg instances only)
# WK_ABOUT_PAGE_REDIRECT_ROUTES=        # comma list of paths, `*` wildcard; `/` redirects anonymous users only
# WK_AIRBRAKE_PROJECT_ID= WK_AIRBRAKE_PROJECT_KEY= WK_AIRBRAKE_ENVIRONMENT=dev-local
