  {
   "name": "user2-login",
   "method": "POST",
   "path": "/api/auth/login",
   "form": {
    "email": "sample2@scm.io",
    "password": "secret"
   },
   "capture_cookie": {
    "user2Cookie": "id"
   }
  },
  {
   "name": "keys-empty",
   "method": "GET",
   "path": "/api/auth/webauthn/keys",
   "as": "user2"
  },
  {
   "name": "register-start-anonymous",
   "method": "POST",
   "path": "/api/auth/webauthn/register/start"
  },
  {
   "name": "register-start-1",
   "method": "POST",
   "path": "/api/auth/webauthn/register/start",
   "as": "user2",
   "capture": {
    "regOptions": "$"
   },
   "capture_cookie": {
    "regCookie": "webauthn-registration"
   },
   "ignore": [
    {
     "path": "$.challenge",
     "reason": "random per request and side"
    }
   ]
  },
  {
   "name": "register-finalize-without-cookie",
   "method": "POST",
   "path": "/api/auth/webauthn/register/finalize",
   "as": "user2",
   "hook": "webauthn_register",
   "hook_args": {
    "options": "regOptions",
    "credential": "user2-key",
    "name": "Diff key",
    "origin": "https://localhost:19590"
   }
  },
  {
   "name": "register-finalize-wrong-challenge",
   "method": "POST",
   "path": "/api/auth/webauthn/register/finalize",
   "as": "user2reg",
   "hook": "webauthn_register",
   "hook_args": {
    "options": "regOptions",
    "credential": "user2-key",
    "name": "Diff key",
    "origin": "https://localhost:19590",
    "challenge_override": "d3JvbmctY2hhbGxlbmdl"
   },
   "expected_divergence": {
    "reason": "Play returns webauthn4j's exception text, which includes the expected challenge; Rust returns a generic message. Both 400 and the challenge is consumed.",
    "paths": [
     "$.messages"
    ]
   }
  },
  {
   "name": "register-finalize-consumed-session",
