    "teamMemberships": [
     {
      "id": "{seedTeamId}",
      "name": "Default",
      "isTeamManager": false
     }
    ]
   },
   "expect_status": 400,
   "expected_divergence": {
    "reason": "Plain member inviting into a team they don't manage: Play answers 400 (\"Can only send invites with team roles for teams you manage.\"); Rust lets only admins and team managers send invites (hardening 46552fe734, \"plain members may not invite at all\") and answers 403.",
    "paths": [
     "$"
    ]
   }
  },
  {
   "name": "send-invites-member-no-teams",
   "method": "POST",
   "path": "/api/auth/sendInvites",
